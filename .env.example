# Required before exposing the service to the internet.
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# Zeabur and most hosts provide PORT automatically. Use 3100 locally.
PORT=3100
MCP_SSE_HOST=0.0.0.0

# Mount this directory on persistent storage in production.
READING_MCP_DATA_DIR=./data

# Optional: restrict browser/app origins.
# MCP_CORS_ORIGIN=https://your-app.example
